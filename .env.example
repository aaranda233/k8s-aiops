# ──────────────────────────────────────────────────────────────────
# k8s-aiops — Configuración de ejemplo
# Copia este fichero a .env y ajusta los valores.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# ─── Diagnóstico (Capa 3 — LLM) ──────────────────────────────────
# Host de Ollama (servidor de inferencia)
OLLAMA_HOST=http://localhost:11434
# Modelo experto fine-tuneado
OLLAMA_MODEL=k8s-rca-orpo:latest

# Modo de diagnóstico: single_shot | react | hybrid
#   single_shot — una llamada al fine-tuneado (más rápido)
#   hybrid      — base investiga + experto diagnostica (mejor Keyword%)
REACT_MODE=hybrid
# Modelo base investigador (solo en modo hybrid)
REACT_BASE_MODEL=qwen2.5:1.5b
# Dry-run del investigador: true = planea kubectl pero no los ejecuta
REACT_DRY_RUN=true

# ─── Auto-remediación (Capa 4) ───────────────────────────────────
# Activar el loop de remediación autónoma con human-in-the-loop
REMEDIATION_ENABLED=false
# Nivel máximo de acción automática:
#   1 = rollout restart / scale (reversible)
#   2 = set resources / patch (requiere aprobación por email)
#   3 = nunca automático (delete / drain siempre escalan)
REMEDIATION_MAX_LEVEL=1

# ─── Notificaciones de remediación ───────────────────────────────
# Canal: teams | email | both | none
NOTIFY_CHANNEL=teams
# URL base pública para los links de aprobación (Teams y email la usan)
WEBHOOK_BASE_URL=http://localhost:8000

# ─── Microsoft Teams (canal recomendado) ─────────────────────────
# Incoming Webhook del canal de ops (Power Automate / conector del canal)
TEAMS_WEBHOOK_URL=https://prod.westeurope.logic.azure.com/workflows/...

# ─── SMTP (canal email / fallback) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@tu-empresa.com
SMTP_PASS=tu_app_password_aqui
SMTP_FROM=alerts@tu-empresa.com
NOTIFY_EMAIL=sre-team@tu-empresa.com

# ─── MLflow (tracking) ───────────────────────────────────────────
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=k8s-aiops

# ─── Detección sobre logs de aplicación (opt-in) ─────────────────
# Además de los eventos K8s, leer logs de stdout/stderr de los pods.
# Solo lectura, acotado. OBLIGATORIO especificar namespaces (nunca todo el cluster).
LOG_COLLECTION_ENABLED=false
LOG_NAMESPACES=llm-app,default        # coma-separados, obligatorio si enabled
LOG_POLL_INTERVAL=30                   # segundos entre lecturas
LOG_TAIL_LINES=50                      # líneas recientes por pod
LOG_SINCE_SECONDS=35                   # ventana temporal de logs (≈ poll_interval)
LOG_MAX_PODS=50                        # tope de pods por ciclo

# ─── Pipeline (web server) ───────────────────────────────────────
# Modo de arranque: live | replay
PIPELINE_MODE=live
# Ventanas de calentamiento antes de detectar
BOOTSTRAP_WINDOWS=10
# Umbral de score para disparar diagnóstico [0-1]
ANOMALY_THRESHOLD=0.80
# Tamaño de ventana temporal en segundos
WINDOW_SIZE=60
# Namespaces a monitorizar (coma-separados; vacío = todos)
NAMESPACES=
